<header class="navbar" id="navbar">
	<nav class="navbar__inner">
		<a class="navbar__logo" href="#inicio" aria-label="Duarte.Dev - Inicio">
			<img
				class="navbar__logo-icon"
				src="/images/duartedev-icono.png"
				alt=""
				width="32"
				height="32"
				loading="eager"
				decoding="async"
			/>
			<span class="navbar__logo-text">Duarte.Dev</span>
		</a>

		<button
			class="navbar__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="navbar-menu"
			aria-label="Abrir menú de navegación"
		>
			<span class="navbar__toggle-bar"></span>
			<span class="navbar__toggle-bar"></span>
			<span class="navbar__toggle-bar"></span>
		</button>

		<div class="navbar__menu" id="navbar-menu">
			<ul class="navbar__links">
				<li class="navbar__item">
					<a class="navbar__link" href="#inicio">Inicio</a>
				</li>
				<li class="navbar__item">
					<a class="navbar__link" href="#servicios">Servicios</a>
				</li>
				<li class="navbar__item">
					<a class="navbar__link" href="#proyectos">Proyectos</a>
				</li>
				<li class="navbar__item">
					<a class="navbar__link" href="#como-trabajo">Cómo trabajo</a>
				</li>
				<li class="navbar__item">
					<a class="navbar__link" href="#sobre-mi">Sobre mí</a>
				</li>
				<li class="navbar__item">
					<a class="navbar__link" href="#contacto">Contacto</a>
				</li>
			</ul>
			<div class="navbar__cta">
				<a class="navbar__cta-button" href="#contacto">Hablemos</a>
			</div>
		</div>
	</nav>
</header>

<script>
	const navbar = document.getElementById("navbar");
	const toggle = document.querySelector(".navbar__toggle");
	const menu = document.getElementById("navbar-menu");
	const links = document.querySelectorAll(".navbar__link");

	const setMenuOpen = (open: boolean) => {
		if (!toggle || !menu) return;
		toggle.setAttribute("aria-expanded", String(open));
		menu.classList.toggle("is-open", open);
		toggle.classList.toggle("is-open", open);
	};

	toggle?.addEventListener("click", () => {
		const isOpen = toggle.getAttribute("aria-expanded") === "true";
		setMenuOpen(!isOpen);
	});

	links.forEach((link) => {
		link.addEventListener("click", () => {
			setMenuOpen(false);
		});
	});

	const onScroll = () => {
		if (!navbar) return;
		if (window.scrollY > 10) {
			navbar.classList.add("is-scrolled");
		} else {
			navbar.classList.remove("is-scrolled");
		}
	};

	onScroll();
	window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
