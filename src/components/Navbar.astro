		border-bottom: 1px solid transparent;
	}

	.navbar.is-scrolled {
		background: rgba(8, 10, 15, 0.9);
		backdrop-filter: blur(10px);
		border-bottom-color: var(--border-color);
	}

	.navbar__inner {
