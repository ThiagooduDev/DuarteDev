	}

	.navbar__toggle.is-open .navbar__toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.navbar__toggle.is-open .navbar__toggle-bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	.navbar__menu {
		display: flex;
