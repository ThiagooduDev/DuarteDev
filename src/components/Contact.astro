									<path d="M21 11.5C21.0034 12.8199 20.6951 14.1219 20.1 15.3C19.3944 16.7118 18.3098 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0034 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92179 4.44061 8.37488 5.27072 7.03258C6.10083 5.69028 7.28825 4.6056 8.7 3.9C9.87812 3.30493 11.1801 2.99656 12.5 3H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</span>
							<span class="contact__item-label">WhatsApp</span>
						</div>
						<a class="contact__item-link" href="https://wa.me/59896101515" target="_blank" rel="noopener noreferrer">096 101 515</a>
					</li>
					<li class="contact__item">
						<div class="contact__item-header">
							<span class="contact__item-icon" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.2"/>
									<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.2"/>
									<circle cx="17" cy="7" r="1" fill="currentColor"/>
								</svg>
							</span>
							<span class="contact__item-label">Instagram</span>
						</div>
						<a class="contact__item-link" href="https://instagram.com/Duartee.tt" target="_blank" rel="noopener noreferrer">Duartee.tt</a>
					</li>
					<li class="contact__item">
						<div class="contact__item-header">
							<span class="contact__item-icon" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.2"/>
									<path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</span>
							<span class="contact__item-label">Correo</span>
						</div>
						<a class="contact__item-link" href="mailto:duartedevv@gmail.com">duartedevv@gmail.com</a>
					</li>
				</ul>
			</div>

			<div class="contact__form-wrap">
				<form class="contact__form" id="contactForm" novalidate>
					<div class="contact__field">
						<label class="contact__label" for="contactName">Nombre</label>
						<input class="contact__input" id="contactName" name="name" type="text" placeholder="Tu nombre" autocomplete="name" />
					</div>
					<div class="contact__field">
						<label class="contact__label" for="contactBusiness">Negocio o proyecto</label>
						<input class="contact__input" id="contactBusiness" name="business" type="text" placeholder="Ej. Barbería, gimnasio, emprendimiento..." />
					</div>
					<div class="contact__field">
						<label class="contact__label" for="contactType">¿Qué necesitás?</label>
						<select class="contact__select" id="contactType" name="type">
							<option value="" disabled selected>¿Qué tipo de proyecto necesitás?</option>
							<option value="Página web">Página web</option>
							<option value="Catálogo">Catálogo</option>
							<option value="Sistema de reservas">Sistema de reservas</option>
							<option value="Web administrable">Web administrable</option>
							<option value="Mantenimiento">Mantenimiento</option>
							<option value="Otro">Otro</option>
						</select>
					</div>
					<div class="contact__field">
						<label class="contact__label" for="contactMessage">Mensaje</label>
						<textarea class="contact__textarea" id="contactMessage" name="message" rows="5" placeholder="Contame brevemente qué tenés en mente..."></textarea>
					</div>
					<button class="contact__button" type="submit">Enviar consulta</button>
					<p class="contact__helper">También podés escribirme directamente por WhatsApp, Instagram o correo.</p>
				</form>
