<script>
	const form = document.getElementById('contactForm');
	if (form) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();

			const nameInput = document.getElementById('contactName');
			const businessInput = document.getElementById('contactBusiness');
			const typeSelect = document.getElementById('contactType');
			const messageInput = document.getElementById('contactMessage');

			const name = nameInput && 'value' in nameInput ? nameInput.value.trim() : '';
			const business = businessInput && 'value' in businessInput ? businessInput.value.trim() : '';
			const type = typeSelect && 'value' in typeSelect ? typeSelect.value : '';
			const message = messageInput && 'value' in messageInput ? messageInput.value.trim() : '';

			const lines = [];
			if (name) lines.push(`Nombre: ${name}`);
			if (business) lines.push(`Negocio o proyecto: ${business}`);
			if (type) lines.push(`Tipo de proyecto: ${type}`);
			if (message) lines.push(`Mensaje: ${message}`);

			const text = lines.length > 0 ? lines.join('\n') : 'Hola, me gustaría hacer una consulta sobre mi proyecto.';
			const url = `https://wa.me/59896101515?text=${encodeURIComponent(text)}`;
			window.open(url, '_blank', 'noopener,noreferrer');
		});
	}
</script>

