---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		<Services />
		<section id="proyectos" aria-label="Proyectos" style="min-height: 60vh;"></section>
		<section id="como-trabajo" aria-label="Cómo trabajo" style="min-height: 60vh;"></section>
		<section id="sobre-mi" aria-label="Sobre mí" style="min-height: 60vh;"></section>
		<section id="contacto" aria-label="Contacto" style="min-height: 60vh;"></section>
	</main>
</Layout>


